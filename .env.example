# =============================================================================
# AI Codebase Intelligence Platform - Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Platform & API Server Configuration
# -----------------------------------------------------------------------------
APP_NAME="AI Codebase Intelligence Platform"
APP_VERSION="0.1.0"
HOST=0.0.0.0
PORT=8000
RELOAD=false
WORKERS=1
API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: 'gemini' (cloud generation) or 'fake' (deterministic offline)
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# -----------------------------------------------------------------------------
# Embedding Model Configuration
# Code-specialized SentenceTransformer model for chunk and query embeddings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=flax-sentence-embeddings/st-codesearch-distilroberta-base

# -----------------------------------------------------------------------------
# GitHub Ingestion Configuration
# Optional personal access token (recommended for higher rate limits on public repos)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# -----------------------------------------------------------------------------
# Vector Storage & Registry Configuration
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma
REGISTRY_PATH=./data/registry.json
DEFAULT_COLLECTION_NAME=codebase
STORAGE_BATCH_SIZE=500

# -----------------------------------------------------------------------------
# Logging & Observability
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: text | json (structured JSON for container logging)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Chunking & Retrieval Parameters
# -----------------------------------------------------------------------------
CHUNK_SIZE=400
CHUNK_OVERLAP=50
BOUNDARY_SEARCH_WINDOW=5
MAX_CONTEXT_TOKENS=2048
